# Required: identifies the runtime mode shown by GET /api/v1/info.
RESEARCHFLOW_ENVIRONMENT=local

# Optional settings with safe local defaults.
RESEARCHFLOW_LOG_LEVEL=INFO
RESEARCHFLOW_AUTH_SESSION_TTL_SECONDS=28800
RESEARCHFLOW_AUTH_LOGIN_PER_MINUTE=60
RESEARCHFLOW_LLM_MAX_CONCURRENCY=1
RESEARCHFLOW_LLM_MAX_QUEUE=8
RESEARCHFLOW_OBSERVABILITY_MAX_SPANS=512
# Authentication is mandatory for business APIs. No default account/password is created.
RESEARCHFLOW_LLM_PROVIDER_MODE=mock
RESEARCHFLOW_LLM_TIMEOUT_SECONDS=5.0
# OpenAI-compatible generation stays local-only and disabled by default.
# Never commit a real key. Set ALLOW_REMOTE only after an explicit data/cost review.
RESEARCHFLOW_LLM_BASE_URL=http://127.0.0.1:18080/v1
RESEARCHFLOW_LLM_MODEL=local-model-not-configured
# RESEARCHFLOW_LLM_API_KEY=
RESEARCHFLOW_LLM_ALLOW_REMOTE=false

# Required database settings. Keep the real password in the ignored .env only.
RESEARCHFLOW_DATABASE_HOST=127.0.0.1
RESEARCHFLOW_DATABASE_PORT=55442
RESEARCHFLOW_DATABASE_USER=researchflow
RESEARCHFLOW_DATABASE_PASSWORD=change-me-local-only
RESEARCHFLOW_DATABASE_NAME=researchflow

# Document ingestion limits and deterministic chunking parameters.
RESEARCHFLOW_UPLOAD_MAX_BYTES=2097152
RESEARCHFLOW_UPLOAD_READ_SIZE=65536
RESEARCHFLOW_DOCUMENT_CHUNK_SIZE=800
RESEARCHFLOW_DOCUMENT_CHUNK_OVERLAP=100

# Local multilingual E5 inference. Keep the pinned revision unchanged unless
# a deliberate reindex migration is planned. The cache directory is gitignored.
RESEARCHFLOW_EMBEDDING_PROVIDER_MODE=local
RESEARCHFLOW_EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RESEARCHFLOW_EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RESEARCHFLOW_EMBEDDING_DIMENSION=384
RESEARCHFLOW_EMBEDDING_NORMALIZE=true
RESEARCHFLOW_EMBEDDING_QUERY_PREFIX="query: "
RESEARCHFLOW_EMBEDDING_PASSAGE_PREFIX="passage: "
RESEARCHFLOW_EMBEDDING_MAX_INPUT_TOKENS=512
RESEARCHFLOW_EMBEDDING_SEGMENT_TOKENS=480
RESEARCHFLOW_EMBEDDING_SEGMENT_OVERLAP_TOKENS=32
RESEARCHFLOW_EMBEDDING_BATCH_SIZE=16
RESEARCHFLOW_EMBEDDING_TIMEOUT_SECONDS=120
RESEARCHFLOW_EMBEDDING_MAX_CONCURRENCY=1
RESEARCHFLOW_EMBEDDING_CPU_THREADS=4
RESEARCHFLOW_EMBEDDING_CACHE_DIR=.cache/huggingface
RESEARCHFLOW_EMBEDDING_LOCAL_FILES_ONLY=true

RESEARCHFLOW_INDEXING_MAX_ATTEMPTS=3
RESEARCHFLOW_INDEXING_STALE_AFTER_SECONDS=600
RESEARCHFLOW_RETRIEVAL_MAX_QUERY_CHARS=1000
RESEARCHFLOW_RETRIEVAL_MAX_TOP_K=50
RESEARCHFLOW_RETRIEVAL_CANDIDATE_MULTIPLIER=4
RESEARCHFLOW_RETRIEVAL_RRF_K=60
RESEARCHFLOW_RETRIEVAL_HNSW_EF_SEARCH=100

# RAG remains disabled by default. The legacy threshold is retained as configuration
# only: its original calibration material is excluded. Recalibrate on your own data.
RESEARCHFLOW_RAG_ENABLED=false
# Agent requires RAG, calibrated reranker, and an independently generated local secret.
RESEARCHFLOW_AGENT_ENABLED=false
# RESEARCHFLOW_AGENT_ACCESS_SECRET=<generate-at-least-32-random-characters-locally>
RESEARCHFLOW_AGENT_APPROVAL_TTL_SECONDS=86400
RESEARCHFLOW_AGENT_MAX_TOOL_CALLS=8
RESEARCHFLOW_AGENT_TOOL_TIMEOUT_SECONDS=240
RESEARCHFLOW_RERANKER_ENABLED=false
RESEARCHFLOW_RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RESEARCHFLOW_RERANKER_MODEL_REVISION=2cfc18c9415c912f9d8155881c133215df768a70
RESEARCHFLOW_RERANKER_MAX_INPUT_TOKENS=512
RESEARCHFLOW_RERANKER_BATCH_SIZE=4
RESEARCHFLOW_RERANKER_CANDIDATE_LIMIT=12
RESEARCHFLOW_RERANKER_TIMEOUT_SECONDS=120
RESEARCHFLOW_RERANKER_MAX_CONCURRENCY=1
RESEARCHFLOW_RERANKER_CPU_THREADS=4
RESEARCHFLOW_RERANKER_CACHE_DIR=.cache/huggingface
RESEARCHFLOW_RERANKER_LOCAL_FILES_ONLY=true
RESEARCHFLOW_EVIDENCE_MIN_RERANK_SCORE=-0.520467877388
RESEARCHFLOW_EVIDENCE_MIN_QUERY_COVERAGE=0.2
RESEARCHFLOW_EVIDENCE_MAX_ITEMS=5
RESEARCHFLOW_RAG_CONTEXT_TOKEN_BUDGET=3000
